# Copia este archivo como .env y completa los valores reales.
# NUNCA subas el archivo .env real al repositorio.

# Django
DJANGO_SECRET_KEY=genera-una-con-python-c-import-secrets-secrets.token_urlsafe-50
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Firebase
# Ruta relativa al archivo de credenciales de Firebase (no lo subas al repo)
FIREBASE_CREDENTIALS_PATH=ServiceAccountKey.json

# Gemini (DocsIA - escaneo de documentos médicos)
GEMINI_API_KEY=tu-api-key-de-google-ai-studio
